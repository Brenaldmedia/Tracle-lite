# Tracle-Lite settings. Copy this file to .env (or add these as environment variables on your host).
# You only need ONE of SESSION_ID or PHONE_NUMBER. Leave both empty to be asked in the console.

# Session ID you got after linking (starts with TRACLE~ or Tracle_). Starts the bot straight away.
SESSION_ID=

# Your WhatsApp number with country code, digits only. A pairing code is printed in the logs.
# (If PHONE_NUMBER is empty, OWNER_NUMBER is used for pairing.)
PHONE_NUMBER=

# Optional
PREFIX=.
OWNER_NAME=
OWNER_NUMBER=
# More owners, comma separated
OWNER_NUMBERS=
DEFAULT_BOT_MODE=public
MENU_IMAGE_URL=
STICKER_NAME=Tracle-Lite
STICKER_AUTHOR=
# PORT is set by most hosts automatically. Use it for health checks.
# PORT=5000

# Bank details shown by .bank / .support (leave empty to hide)
DEFAULT_BANK_NAME=
DEFAULT_ACCOUNT_NUMBER=
DEFAULT_ACCOUNT_NAME=

# Optional API keys for some commands
WEATHER_API_KEY=
NEWS_API_KEY=
GNEWS_TOKEN=
NEXORACLE_API_KEY=

# Optional: .report sends bug reports to your email
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=465
REPORT_SMTP_USER=
REPORT_SMTP_PASS=
REPORT_EMAIL_TO=

# Optional: unlock the bot's /api/bridge/* endpoints (off when empty)
BRIDGE_TOKEN=

# Optional: where short Tracle_xxxx session IDs are downloaded from
# SESSION_GENERATOR_URL=https://tracle-sessions.brenaldmedia.com
